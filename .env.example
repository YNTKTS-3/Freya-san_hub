# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Freya-san Hub Platform Configuration (no secrets hardcoded in source)
PROJECT_NAME="Freya-san Hub"
PROJECT_VERSION="5.0"
BOT_NAME="Freya-san bot by Pak Ujan"
DEFAULT_LANGUAGE="id"
DEFAULT_THEME="system"

# Owner & Security Configuration (set via Secrets / environment)
OWNER_NUMBER=""
OWNER_PASSCODE=""
SESSION_SECRET=""
BACKUP_ENCRYPTION_KEY=""
WHATSAPP_AUTO_CONNECT="false"

